<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://schutz.com.tr/KaffeeSignage" version="1.0.1" viewmodes="maximized">
    <tizen:application id="KfSchutz01.KaffeeSignage" package="KfSchutz01" required_version="2.4"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>KaffeeSignage</name>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:content-security-policy>default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; frame-src *; img-src * data: blob:; media-src * blob:;</tizen:content-security-policy>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
